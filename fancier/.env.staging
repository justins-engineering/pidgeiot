# Only takes effect when FANCIER_ENV=staging is set — see build.rs. Baked
# into the bundle `wrangler deploy --env staging` ships as fancier-staging
# (and into a version preview uploaded with wrangler.staging.toml), never
# into a regular `dx build --release`/prod deploy.
#
# API_HOST is the dedicated `dovecote-staging` script (see dovecote's
# [env.staging] in wrangler.toml) on its pidgeiot.com hostname: the Kratos
# session cookie is scoped to that domain, so a browser session only ever
# reaches an API served from under it.
KRATOS_BROWSER_URL="https://auth.pidgeiot.com"
SESSION_COOKIE_NAME="session_expiry"
API_HOST = "https://api-staging.pidgeiot.com"
# Staging's own demo pigeon -- lives in the "Demo Flock" flock on
# dovecote-staging, created for the public demo route (see dovecote's
# DEMO_PIGEON_IDS note, wrangler.toml). NOT the prod demo id.
DEMO_PIGEON_ID = "0ec346b8c062431d0bada55f93ffa6089c6fd35eda5d64c75aff0381c4ea12a3"
