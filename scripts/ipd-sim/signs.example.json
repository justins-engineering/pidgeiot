{
  "control_port": 8900,
  "state_root": "ipd-sim-state",
  "signs": [
    {
      "slug": "sign-a",
      "name": "Lot A entrance",
      "port": 8901,
      "data_items": ["target_version", "target_config"],
      "poll": {
        "url": "http://127.0.0.1:8787/device/pigeons/PIGEON_ID_A/shadow",
        "format": "json",
        "every_secs": 10,
        "user_agent": "sign-sim/1.0",
        "auth": "bearer",
        "token_file": "/home/YOU/.config/pidgeiot/ipd-sim/sign-a.token"
      }
    },
    {
      "slug": "sign-b",
      "name": "Lot B entrance",
      "port": 8902,
      "data_items": ["target_version", "target_config"],
      "poll": {
        "url": "http://127.0.0.1:8787/device/pigeons/PIGEON_ID_B/shadow",
        "every_secs": 10,
        "token_file": "/home/YOU/.config/pidgeiot/ipd-sim/sign-b.token"
      }
    },
    {
      "slug": "sign-c",
      "name": "Garage level 1",
      "port": 8903,
      "data_items": ["target_version", "target_config"],
      "poll": {
        "url": "http://127.0.0.1:8787/device/pigeons/PIGEON_ID_C/shadow",
        "every_secs": 10,
        "token_env": "IPD_SIM_TOKEN_C"
      }
    }
  ]
}
