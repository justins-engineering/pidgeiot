# netns RFC 9146 rebind harness image. Build from the REPO ROOT context:
#   docker build -f scripts/test/Dockerfile.cid-harness -t loft-cid-harness .
# Runs privileged (needs netns/veth/nft/conntrack); see cid-netns-harness.sh.

FROM rust:1-trixie AS build
# Pinned to the exact version Phase 0 gated the design on, so the gate's
# own mbedTLS cannot drift silently under it. A deliberate Debian security
# bump requires editing this pin (and re-running Phase 0's expectation).
RUN apt-get update \
  && apt-get install -y --no-install-recommends libmbedtls-dev=3.6.5-0.1~deb13u1 \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
# The real terminator, dual-stack, and the harness client/stub (a detached
# crate, so built by its own manifest).
RUN cargo build -p loft --release --features mbedtls \
  && cargo build --release --manifest-path scripts/test/cid-harness/Cargo.toml

FROM debian:trixie-slim
# gawk: the DTLS record walker needs strtonum. procps: so kill/sysctl/pkill
# exist rather than silently 127-ing (the script still writes /proc and
# tracks PIDs directly, but a slim image with these missing was the root
# of an earlier gate-integrity bug).
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       libssl3t64 libmbedtls21=3.6.5-0.1~deb13u1 ca-certificates \
       iproute2 nftables conntrack tshark gawk procps \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/loft /usr/local/bin/loft
COPY --from=build /src/scripts/test/cid-harness/target/release/cid_client /usr/local/bin/cid_client
COPY --from=build /src/scripts/test/cid-harness/target/release/psk_stub /usr/local/bin/psk_stub
COPY scripts/test/run-cid-netns.sh /usr/local/bin/run-cid-netns.sh
RUN chmod +x /usr/local/bin/run-cid-netns.sh
ENTRYPOINT ["/usr/local/bin/run-cid-netns.sh"]
