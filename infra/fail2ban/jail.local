# fail2ban sshd jail for the JES LLC production VPS (Debian 13 trixie,
# WAN iface ens3). Deployed by hand — nothing in this repo pushes files to
# the host — copy this to /etc/fail2ban/jail.local. Full cutover procedure,
# reasoning, and verification steps: docs/infra/ssh-hardening.md.
#
# What this replaces: a hand-rolled iptables/ip6tables xt_recent throttle
# on port 22 that counts TCP CONNECTIONS, not authentication failures — a
# burst of legitimate SSH sessions (several automation connections inside
# a minute) trips it exactly like a credential-guessing script would.
# fail2ban instead parses sshd's own auth-failure log lines, so it only
# acts on requests that actually failed to authenticate.

[DEFAULT]
# Loopback only. The operator's own network has no static IPv4 address, so
# there is no address worth pinning here — and fail2ban has no special case
# for the operator, meaning a bad login from the admin workstation is banned
# exactly like anyone else's. The mitigation is therefore not an exemption
# but a short first ban (see bantime below) plus out-of-band console access,
# rather than pretending a lockout can't happen.
#
# If a dynamic-DNS hostname for the admin network ever exists, fail2ban does
# accept hostnames here and re-resolves them, so appending one is a real
# improvement over a hardcoded address:
#   ignoreip = 127.0.0.1/8 ::1 admin.example.dyndns.org
# Do NOT substitute the ISP's whole netblock — that exempts every other
# customer on the same ISP, which is a meaningful share of the scanning
# traffic this jail exists to stop.
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = true
port = ssh
filter = sshd

# Log source (backend): this host logs sshd to the systemd journal — a
# stock Debian 13 install has no rsyslog, so /var/log/auth.log doesn't
# exist and fail2ban's backend = auto would find no log to tail and stay
# silently harmless (jail reports healthy, matches nothing, bans nothing).
# Read the journal directly instead. If this particular host DOES have
# rsyslog + /var/log/auth.log, backend = systemd still works fine — this
# setting is safe either way, but confirm which applies before trusting it
# (see the runbook's verification step; if the live sshd unit isn't named
# ssh.service, also add an explicit `journalmatch` override here).
backend = systemd

# Ban action: Debian 13's fail2ban packaging can default to an
# nftables-based ban action, but this host's firewall is authored and
# persisted entirely through iptables/ip6tables + iptables-persistent
# (rules.v4/rules.v6, netfilter-persistent save). A ban landing in a
# separate native nftables table would be invisible to `iptables -L -v -n`
# and to `netfilter-persistent save` — functionally disconnected from the
# ruleset this host's operators actually audit and persist by hand.
# iptables-multiport shells out to the same `iptables`/`ip6tables`
# commands already in use here, so bans land in and are removed from the
# same INPUT chain regardless of whether that binary happens to be the
# iptables-legacy implementation or the iptables-nft compatibility shim
# (both accept the same CLI syntax this action uses) — confirm which is
# active with `iptables --version` as a sanity check, not because it
# changes this choice.
banaction = iptables-multiport

# findtime/maxretry: five failed authentication attempts inside a
# ten-minute window is enough headroom that a mistyped password or a
# misconfigured client key doesn't trip a ban, while still catching any
# credential-guessing attempt, which needs far more than five tries in
# ten minutes to be worth running at all.
findtime = 10m
maxretry = 5

# bantime: start at ten minutes, not an hour. The operator's address is
# dynamic and therefore cannot be exempted, so the first ban is the one
# they are most likely to eat themselves — ten minutes is a wait, an hour
# is a support ticket. It costs nothing against real scanners because the
# escalation below doubles every repeat: an actual guessing attempt is at
# 20m, 40m, 80m... within the hour anyway, while a one-off operator
# fat-finger never gets past the first step. The cap keeps any single ban
# from being effectively permanent, which matters more than usual here
# because a dynamic address can later be reassigned to someone innocent.
bantime = 10m
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1d
